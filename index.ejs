<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <h1> Welcome to my blog(City Rabbit)</h1>
  <ul>
    <li><a href="/">Home</a></li>
    <li><a href="create">Create blog</a></li>
    <li><a href="about">About</a></li>
  </ul>
  <% if(users.length> 0) { %>
    <% for (let i=0 ; i< users.length ; i++) { %>
      <h2>
        <%= users[i].title %>
      </h2>
      <p>
        <%= users[i].content %>
      </p>
      <a href="/edit/<%= users[i].id %>">Edit</a>
      <form action="/delete/<%= users[i].id %>" method="POST">
        <button type="submit">Delete</button>
      </form>
      <% } %>
        <%} %>

          <div class="container">
            <!-- 1. CHECK IF WE ARE IN EDIT MODE -->
            <% if (editingPost !==null) { %>

              <h2>Edit Post</h2>
              <!-- Points to the update route with the index we want to overwrite -->
              <form action="/update/<%= editingId %>" method="POST">
                <label for="title">Post Title:</label><br />
                <input type="text" id="title" name="title" value="<%= editingPost.title %>" required><br />

                <label for="content">Content:</label><br />
                <textarea id="content" name="content" required><%= editingPost.content %></textarea><br />

                <button type="submit">Save Changes</button>
                <a href="/">Cancel</a>
              </form>

              <% } %>
          </div>

          <% if (users.length> 0) { %>
            <% for (let i=0; i < users.length; i++) { %>
              <!-- Safety check in case you used the "Null/Empty" strategy previously -->
              <% if (users[i]) { %>
                <div class="blog-post">
                  <h2>
                    <%= users[i].title %>
                  </h2>
                  <p>
                    <%= users[i].content %>
                  </p>

                  <div class="post-actions">
                    <!-- Edit link passes the array loop index 'i' into the URL -->
                    <a href="/edit/<%= i %>" class="btn-edit">Edit</a>

                    <!-- Delete button must be a form to safely hit an app.post route -->
                    <form action="/delete/<%= i %>" method="POST" style="display:inline;">
                      <button type="submit" class="btn-delete"
                        onclick="return confirm('Are you sure you want to delete this post?')">Delete</button>
                    </form>
                  </div>
                </div>
                <hr>
                <% } %>
                  <% } %>
                    <% } else { %>
                      <p>No posts yet. <a href="/create">Create your first blog post!</a></p>
                      <% } %>


                        </div>


</body>

</html>